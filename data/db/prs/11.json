    "11906": {
      "number": 11906,
      "title": "[Feature] Integrate speculative dynamic top-k in speculative decoding",
      "author": "seven-mile",
      "html_url": "https://github.com/vllm-project/vllm-ascend/pull/11906",
      "changed_files": 23,
      "additions": 1341,
      "deletions": 32,
      "age_days": 133.9,
      "ci": {
        "total": 14,
        "failed": 0,
        "failed_names": [],
        "pending": 0,
        "state": "success"
      },
      "reviews": {
        "approvals": 0,
        "changes_requested": 0,
        "total": 3,
        "mine": null
      },
      "owned": [
        {
          "file": "vllm_ascend/ascend_config.py",
          "status": "modified",
          "additions": 93,
          "deletions": 0
        },
        {
          "file": "vllm_ascend/ascend_forward_context.py",
          "status": "modified",
          "additions": 9,
          "deletions": 1
        }
      ],
      "owned_add": 102,
      "owned_del": 1,
      "reason": "新进入队列",
      "first_edition": "2026-11-23-0800",
      "review": {
        "number": 11906,
        "verdict": "look",
        "confidence": "medium",
        "summary": "新增 Spec-K 动态 top-k 配置与 token_top_ks 前向透传，启用时把 MoE 通信方式固定为 AllGather。",
        "intent": "让验证阶段按每 token 不同 top-k 路由，需要引擎级策略和逐 token top-k 注入；为兼容可变 top-k，Spec-K 启用时统一走 AllGather 而不是 All2AllV/MC2。",
        "focus": [
          {
            "file": "vllm_ascend/ascend_config.py",
            "point": "SpecKConfig 校验较完整（draft_model、enforce_eager、非量化、无 prefix caching/async/PP/CP/V2、无 EPLB/自定义 expert map），但未拒绝 LoRA；与下方强制 AllGather 的前置条件存在冲突。"
          },
          {
            "file": "vllm_ascend/ascend_forward_context.py",
            "point": "select_moe_comm_method 在 spec_k 启用时无条件覆盖为 ALLGATHER，且排在 LoRA 的 AlltoAll 分支之前；这绕过了注释里“LoRA + EP 必须 AlltoAll”的约束，也不会提示用户通信已退化。"
          },
          {
            "file": "vllm_ascend/ascend_forward_context.py",
            "point": "token_top_ks 每次进入 set_ascend_forward_context 都写入 _EXTRA_CTX（None 会覆盖旧值），并已加入 extra_attrs；需确认不走该 context 的 forward 不会读到未初始化属性。"
          }
        ],
        "risks": [
          {
            "level": "high",
            "text": "reviewer 指出 EP AllGather 路径下收缩 top-k 的 dropped slot 会被赋 num_experts，若在 expert_map 查表前未处理会越界；Spec-K 恰好强制这条路径，需修复并覆盖 EP + reduced budget。"
          },
          {
            "level": "medium",
            "text": "强制 AllGather 与 LoRA+EP 的 AlltoAll 要求冲突，SpecKConfig 又未拒绝 LoRA；LoRA + EP + Spec-K 组合可能选错通信实现。"
          },
          {
            "level": "medium",
            "text": "reviewer 指出 grouped routing 的 native 输出可能无序，按位置前缀裁剪会保留低排名 expert；需按实际选择分数（含 correction bias）排序后再掩码。"
          }
        ],
        "tests": "新增 test_spec_k.py、test_dynamic_topk.py、test_ascend_config.py、test_ascend_forward_context.py、test_model_runner_v1.py 等，覆盖配置校验与逐 token 掩码；缺 EP reduced-budget 与 LoRA 组合用例。",
        "questions": [
          "Spec-K 是否应直接拒绝 LoRA，或把 spec_k 的 AllGather 分支放在 LoRA 判断之后？",
          "EP AllGather + 收缩 top-k 时，num_experts 的 dropped slot 在 expert_map 查表前是否已掩码？能否补对应用例？"
        ],
        "recommend": "owned 的配置与前向透传方向正确，但先修 EP reduced-budget/排序问题、澄清 LoRA 交互并解决 merge 冲突后再批。"
      },
      "review_sha": "fe27710e0d6c",
      "head_sha": "c86cce52bb3044c92ea7dae6a0a37cd3d7e3a106"
    },
