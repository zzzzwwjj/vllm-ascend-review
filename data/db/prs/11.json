    "11075": {
      "number": 11075,
      "title": "[BugFix][MoE] Fall back to native experts selection when CANN rejects renorm=1",
      "author": "Ray-RP",
      "html_url": "https://github.com/vllm-project/vllm-ascend/pull/11075",
      "changed_files": 2,
      "additions": 145,
      "deletions": 16,
      "age_days": 147.7,
      "ci": {
        "total": 0,
        "failed": 0,
        "pending": 0,
        "state": "unknown",
        "failed_names": []
      },
      "reviews": {
        "approvals": 0,
        "changes_requested": 0,
        "total": 3,
        "mine": null
      },
      "owned": [],
      "owned_add": 0,
      "owned_del": 0,
      "reason": "新进入队列",
      "first_edition": "2026-11-23-1300",
      "review": {
        "number": 11075,
        "verdict": "approve",
        "confidence": "high",
        "summary": "CANN 拒绝 renorm=1 时捕获异常并翻转进程级开关，后续改走 native 专家选择，避免每步崩溃。",
        "intent": "部分 CANN 不支持 aclnnMoeGatingTopK renorm=1，致 Qwen3-MoE 等 norm_topk_prob=true 模型崩溃；改为一次性降级到 native 路径。",
        "focus": [
          {
            "file": "vllm_ascend/ops/fused_moe/experts_selector.py",
            "point": "异常匹配只看 message 中 moegatingtopk + renorm 关键字，且仅对 renormalize=True 生效；确认其它 CANN 版本报错文本能命中，且不会吞掉无关 RuntimeError。"
          },
          {
            "file": "vllm_ascend/ops/fused_moe/experts_selector.py",
            "point": "check_npu_moe_gating_top_k 在 flag 翻转后对 renormalize=True 返回 False，后续 forward 不再触发异常；确认 flag 进程级语义在多 worker 场景可接受。"
          }
        ],
        "risks": [
          {
            "level": "low",
            "text": "字符串匹配依赖 CANN 报错措辞，版本变化可能匹配不上而继续抛错（会直接暴露，不静默出错）。"
          },
          {
            "level": "low",
            "text": "flag 翻转后不可恢复，若只是偶发异常会永久失去 fused 路径（仅性能损失）。"
          }
        ],
        "tests": "新增两条 UT 覆盖「触发降级」与「无关异常继续抛出」，PR 描述称已在 910B1 + Qwen3-30B-A3B 端到端验证，CI 5 项全绿。",
        "questions": [
          "是否考虑按 CANN 版本号一次性判定，替代对报错文本的字符串匹配？"
        ],
        "recommend": "小改动、回退路径清晰、UT 到位，可以批准。"
      },
      "review_sha": "9a0bedecef94",
      "head_sha": "4e0d0008e591d4fbd2776d32bf3bb6f7943ec5c5"
    },
